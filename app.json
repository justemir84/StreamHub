{
  "expo": {
    "name": "StreamHub",
    "slug": "streamhub",
    "version": "0.1.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1b3b8f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.justemir84.streamhub",
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LEANBACK_LAUNCHER"
          ]
        }
      ],
      "banner": "./assets/banner.png"
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "7bf35a46-51da-49e6-85a7-7f24540c7a91"
      }
    },
    "owner": "justemir84",
    "plugins": [
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withTV",
      "./plugins/withSigning"
    ]
  }
}
